# --- Generic ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# --- Flash: 16 MB quad, custom partition table with an ESP-SR "model" partition ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
# Relative to the ESP-IDF CMake project generated by esp-idf-sys in
# target/<triple>/<profile>/build/esp-idf-sys-<hash>/out, i.e. the workspace root.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"

# --- PSRAM: ESP32-S3-WROOM-1-N16R8 (8 MB octal PSRAM) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# --- ESP-SR models packed into srmodels.bin (flashed to the "model" partition) ---
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_JARVIS_TTS=y
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SR_NSN_WEBRTC=y

# --- Drivers: the BSP uses the new I2C master / I2S / ADC oneshot drivers, while
# esp-idf-hal links the legacy ones. Both may coexist as long as each peripheral
# instance is only driven by one of them, so skip the startup conflict check.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y
CONFIG_I2S_SKIP_LEGACY_CONFLICT_CHECK=y
CONFIG_ADC_SKIP_LEGACY_CONFLICT_CHECK=y
CONFIG_RMT_SKIP_LEGACY_CONFLICT_CHECK=y
CONFIG_TEMP_SENSOR_SKIP_LEGACY_CONFLICT_CHECK=y
